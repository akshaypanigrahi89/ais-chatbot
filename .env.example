# SIA Chatbot - Environment Variables

# === Application ===
APP_NAME=SIA Chatbot
APP_VERSION=1.0.0
DEBUG=false

# === LLM Configuration ===
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# === API Keys ===
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
EURON_API_KEY=your_euron_api_key_here
EURON_BASE_URL=https://api.euron.one/api/v1/euri

# === Vector Store ===
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_COLLECTION=knowledge_base

# === Elasticsearch (Phase 2) ===
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=documents

# === Database ===
DATABASE_URL=sqlite:///./sia_chatbot.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/sia_chatbot

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Authentication ===
JWT_SECRET=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# === Storage ===
STORAGE_PROVIDER=local
STORAGE_BUCKET=sia-chatbot-storage
STORAGE_PATH=./storage

# === Chunking ===
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# === Retrieval ===
SIMILARITY_THRESHOLD=0.70
MAX_RESULTS=10
RERANKER_ENABLED=false

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=60

# === CORS ===
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
